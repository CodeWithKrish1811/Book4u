# ===================================================================
# Book4u - Environment Variables Configuration Template
# ===================================================================
# IMPORTANT INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root or relevant subdirectories.
# 2. Never commit the actual '.env' file containing real secrets to Git.
# 3. Fill in your local environment credentials below.
# ===================================================================

# -------------------------------------------------------------------
# Backend Server Configuration
# -------------------------------------------------------------------
SERVER_PORT=8080

# -------------------------------------------------------------------
# MySQL Database Configuration (Spring JDBC)
# -------------------------------------------------------------------
# JDBC URL format: jdbc:mysql://<host>:<port>/<database_name>?<options>
DB_URL=jdbc:mysql://localhost:3306/book4u_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# HikariCP Connection Pool Settings
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=5000

# -------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------------
# Frontend Environment Configuration (Vite)
# -------------------------------------------------------------------
# Base URL for the Book4u Spring Boot REST API
VITE_API_BASE_URL=http://localhost:8080/api
